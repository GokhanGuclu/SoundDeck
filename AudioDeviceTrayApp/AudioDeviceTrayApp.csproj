<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- Store (MSIX) build: pass /p:StoreBuild=true. It targets a Windows 10 SDK so the
         packaged-app APIs (StartupTask) are available, and defines the STORE constant,
         which switches off the Velopack updater (Store apps update through the Store). -->
    <TargetFramework Condition="'$(StoreBuild)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(StoreBuild)' != 'true'">net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(StoreBuild)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
    <DefineConstants Condition="'$(StoreBuild)' == 'true'">$(DefineConstants);STORE</DefineConstants>

    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>SoundDeck</AssemblyName>
    <Product>SoundDeck</Product>
    <Company>Gökhan Güçlü</Company>
    <Authors>Gökhan Güçlü</Authors>
    <Copyright>Copyright © 2025 Gökhan Güçlü</Copyright>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <Description>Your audio control center — switch devices, manage your microphone and control volume with global hotkeys</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" Version="3.0.3" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

</Project>